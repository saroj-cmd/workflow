# ---- Database (Supabase → Project Settings → Database → Connection string) ----
# Pooled connection ("Transaction pooler", port 6543). Keep ?pgbouncer=true at the end.
DATABASE_URL="postgresql://postgres.YOURPROJECT:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection ("Session pooler", port 5432). Used only for creating tables.
DIRECT_URL="postgresql://postgres.YOURPROJECT:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ---- File storage (Supabase → Project Settings → API) ----
# Leave these empty to store uploads on local disk instead (local development only).
SUPABASE_URL="https://YOURPROJECT.supabase.co"
SUPABASE_SERVICE_KEY="your-service-role-or-secret-key"
SUPABASE_BUCKET="workflow-files"

# ---- App ----
# Generate one with: openssl rand -hex 32
JWT_SECRET="change-me"
PORT=4000
EMPLOYEE_ID_PREFIX="EMP"
CORS_ORIGIN="http://localhost:5173"
SUPERADMIN_EMAIL="superadmin@example.com"
SUPERADMIN_PASSWORD="choose-a-strong-password"
